msgid "Environment variable %(name)s is not set."
msgstr "Umgebungsvariable %(name)s ist nicht gesetzt."

#, python-format
msgid "Response is not JSON (HTTP %(code)s)"
msgstr "Antwort ist kein JSON (HTTP %(code)s)"

#, python-format
msgid "Too many pages from %(res)s"
msgstr "Zu viele Seiten von %(res)s"

msgid "baramundi endpoint ID"
msgstr "baramundi-Endpoint-ID"

msgid "Set by the endpoint sync; can be corrected manually"
msgstr "Wird vom Endpoint-Abgleich gesetzt; kann manuell korrigiert werden"

msgid "server URL"
msgstr "Server-URL"

msgid "e.g. https://bms.example.local (without /bconnect)"
msgstr "z. B. https://bms.example.local (ohne /bconnect)"

msgid "user"
msgstr "Benutzer"

msgid "password environment variable"
msgstr "Umgebungsvariable für das Passwort"

msgid "verify TLS"
msgstr "TLS prüfen"

msgid "CA bundle path"
msgstr "Pfad zum CA-Bundle"

msgid "timeout (s)"
