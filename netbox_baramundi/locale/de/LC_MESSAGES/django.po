msgid "Test connection"
msgstr "Verbindung testen"

msgid "Sync endpoint IDs now"
msgstr "Endpoint-IDs jetzt abgleichen"

msgid "Settings saved."
msgstr "Einstellungen gespeichert."

#, python-format
msgid "Connection failed: %(err)s"
msgstr "Verbindung fehlgeschlagen: %(err)s"

#, python-format
msgid "Connected to %(name)s, version %(version)s."
msgstr "Verbunden mit %(name)s, Version %(version)s."

